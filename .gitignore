
# Per-branch agent handover scratchpad. Detailed step plans, push-back
# discussions, and Final Review Summaries live here so they never leak into
# the MR diff or remote. Distilled motivation lands in WAL.md at merge.
.plans/
.data/
.DS_Store

# Host virtualenv and build artifacts. `agent-make venv` recreates all of it.
.venv/
__pycache__/
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.coverage

# Working project directories: footage, manifests and renders.
projects/
